from odoo import fields, models


class {{ spec.model_class }}(models.Model):
    _name = "{{ spec.model }}"
    _description = {{ spec.model_description | pyrepr }}

    name = fields.Char(required=True)
{%- for field in spec.fields %}
{%- if field.type in ("many2one", "many2many") %}
    {{ field.name }} = fields.{{ field.odoo_class }}("{{ field.comodel }}", string={{ field.label | pyrepr }})
{%- elif field.type == "selection" %}
    {{ field.name }} = fields.Selection(
        [{% for key, label in field.selection_items %}("{{ key }}", {{ label | pyrepr }}){% if not loop.last %}, {% endif %}{% endfor %}],
        string={{ field.label | pyrepr }},
    )
{%- else %}
    {{ field.name }} = fields.{{ field.odoo_class }}(string={{ field.label | pyrepr }})
{%- endif %}
{%- endfor %}
